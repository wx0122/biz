.hospital-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.hospital-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.hospital-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.hospital-address {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.hospital-city {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.hospital-departments {
  margin-top: 10rpx;
}
