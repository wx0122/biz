page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #333;
  background-color: #f5f5f5;
}

.container {
  padding: 30rpx;
}

/* Common styles */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: #3EAF9F;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  background: #b0d9d3;
  color: rgba(255, 255, 255, 0.7);
}

.btn-orange {
  background: #FF8C42;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border: none;
}

.btn-wechat {
  background: #07C160;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border: none;
}

.btn-alipay {
  background: #1677FF;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border: none;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.price {
  color: #FF8C42;
  font-weight: 700;
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: #E8F6F4;
  color: #3EAF9F;
  margin-right: 12rpx;
}

.badge {
  display: inline-block;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  color: #fff;
}

.badge-pending { background: #FF8C42; }
.badge-paid { background: #3EAF9F; }
.badge-completed { background: #52c41a; }
.badge-cancelled { background: #999; }
.badge-processing { background: #1677FF; }
