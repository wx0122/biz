<view class="container">
  <!-- User Header -->
  <view class="card user-header">
    <view class="avatar-wrap">
      <image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
    </view>
    <view class="user-info">
      <view class="user-name">{{userInfo.nickname || '未登录用户'}}</view>
      <view class="user-phone" wx:if="{{userInfo.phone}}">{{userInfo.phone}}</view>
      <view class="user-id">ID: {{userInfo.openid ? userInfo.openid.slice(0, 8) + '...' : '--'}}</view>
    </view>
    <view class="edit-btn" bindtap="editProfile">编辑</view>
  </view>

  <!-- Stats -->
  <view class="card stats-row">
    <view class="stat-item" bindtap="goToOrders" data-tab="all">
      <view class="stat-num">{{stats.totalOrders || 0}}</view>
      <view class="stat-label">全部订单</view>
    </view>
    <view class="stat-item" bindtap="goToOrders" data-tab="booking">
      <view class="stat-num">{{stats.bookings || 0}}</view>
      <view class="stat-label">陪诊记录</view>
    </view>
    <view class="stat-item" bindtap="goToOrders" data-tab="training">
      <view class="stat-num">{{stats.trainings || 0}}</view>
      <view class="stat-label">培训记录</view>
    </view>
  </view>

  <!-- Menu -->
  <view class="card menu-card">
    <view class="menu-item" bindtap="goToOrders" data-tab="pending">
      <text class="menu-icon">📋</text>
      <text class="menu-text">待处理订单</text>
      <text class="menu-badge" wx:if="{{stats.pendingOrders > 0}}">{{stats.pendingOrders}}</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="viewRecords">
      <text class="menu-icon">📖</text>
      <text class="menu-text">就诊记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goTraining">
      <text class="menu-icon">🎓</text>
      <text class="menu-text">培训报名</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goBooking">
      <text class="menu-icon">🏥</text>
      <text class="menu-text">预约陪诊</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="card menu-card">
    <view class="menu-item" bindtap="showAbout">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="contactService">
      <text class="menu-icon">📞</text>
      <text class="menu-text">联系客服</text>
      <text class="menu-arrow">›</text>
    </view>
    <button class="menu-item menu-item-btn" open-type="feedback">
      <text class="menu-icon">💬</text>
      <text class="menu-text">意见反馈</text>
      <text class="menu-arrow">›</text>
    </button>
  </view>

  <!-- Records Modal -->
  <view class="modal-mask" wx:if="{{showRecordsModal}}" bindtap="closeRecords">
    <view class="modal-content modal-tall" catchtap="">
      <view class="modal-title">就诊记录</view>
      <scroll-view scroll-y class="records-scroll">
        <view class="record-item" wx:for="{{records}}" wx:key="id">
          <view class="record-header">
            <text class="record-hospital">{{item.hospital_name}}</text>
            <view class="badge badge-{{item.status}}">{{item.status_text || item.status}}</view>
          </view>
          <view class="record-detail">{{item.service_type}} · {{item.booking_date}}</view>
          <view class="record-detail">就诊人：{{item.patient_name}}</view>
        </view>
        <view class="empty-records" wx:if="{{records.length === 0}}">
          <text>暂无就诊记录</text>
        </view>
      </scroll-view>
      <view class="modal-close-btn" bindtap="closeRecords">关闭</view>
    </view>
  </view>

  <!-- Edit Profile Modal -->
  <view class="modal-mask" wx:if="{{showEditModal}}" bindtap="closeEdit">
    <view class="modal-content" catchtap="">
      <view class="modal-title">编辑资料</view>
      <view class="form-item">
        <text class="form-label">昵称</text>
        <input class="form-input" value="{{editForm.nickname}}" bindinput="onEditNickname" placeholder="请输入昵称" />
      </view>
      <view class="form-item">
        <text class="form-label">手机号</text>
        <input class="form-input" type="number" maxlength="11" value="{{editForm.phone}}" bindinput="onEditPhone" placeholder="请输入手机号" />
      </view>
      <view class="modal-actions">
        <button class="btn-primary" bindtap="saveProfile">保存</button>
      </view>
    </view>
  </view>
</view>
